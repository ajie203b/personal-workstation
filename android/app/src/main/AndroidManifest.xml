<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 桌面快捷方式 / 深链（v2.0）：com.personal.workstation://quickadd 与 ://today
                 小组件单条任务（v3.1）：com.personal.workstation://task?id=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.personal.workstation" android:host="quickadd" />
                <data android:scheme="com.personal.workstation" android:host="today" />
                <data android:scheme="com.personal.workstation" android:host="task" />
            </intent-filter>

            <!-- 长按图标的快捷方式清单 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- 今日待办小组件：桌面 / 小米负一屏（走系统「安卓小组件」入口）
             不声明 miuiWidget：未进 MIUI 适配名单的第三方卡片会在小米主池里显示
             「努力适配中」，去掉后只出现在底部的安卓小组件分类，功能完整可用。 -->
        <receiver
            android:name=".TaskWidgetProvider"
            android:exported="true"
            android:label="@string/task_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 小米 Widget 展现刷新（部分负一屏实现仍会发） -->
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>

        <!-- 小组件「+」：原生添加框，不开主界面 -->
        <activity
            android:name=".WidgetAddTaskActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.personal.workstation.widget"
            android:theme="@style/WidgetAddTheme"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- 小组件勾选：透明撒花层，不开主界面、不挡触摸 -->
        <activity
            android:name=".WidgetCompleteActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="com.personal.workstation.widget"
            android:theme="@style/WidgetConfettiTheme" />

        <!-- 分享 / 应用内更新共用：更新包下载到 cache/updates/，由 file_paths.xml 的 cache-path 覆盖 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 小组件完成任务时的成功振动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 任务到期提醒（v1.3）：本地通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 导出到公共「下载」目录：Android 10+ 走 MediaStore 免权限，只有 6–9 要这个 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- 应用内更新：下载新版 APK 后拉起系统安装器（AppUpdatePlugin）；
         用户仍需在系统设置里允许本应用「安装未知应用」 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
