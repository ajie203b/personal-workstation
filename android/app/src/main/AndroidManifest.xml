<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 桌面快捷方式 / 深链（v2.0）：com.personal.workstation://quickadd 与 ://today
                 小组件单条任务（v3.1）：com.personal.workstation://task?id=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.personal.workstation" android:host="quickadd" />
                <data android:scheme="com.personal.workstation" android:host="today" />
                <data android:scheme="com.personal.workstation" android:host="task" />
            </intent-filter>

            <!-- 长按图标的快捷方式清单 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- 今日待办小组件：桌面 / 小米负一屏 -->
        <receiver
            android:name=".TaskWidgetProvider"
            android:exported="true"
            android:label="@string/task_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 小米 Widget 展现刷新（负一屏曝光时触发） -->
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- 小米 Widget 标识：没这个 meta 的只会出现在「安卓小部件」分类，
                 负一屏「+」的小部件主列表里看不到（小米小部件技术规范 4） -->
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>

        <!-- 小米 Widget 版本号（小米小部件技术规范 10） -->
        <meta-data
            android:name="miuiWidgetVersion"
            android:value="1" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 任务到期提醒（v1.3）：本地通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 导出到公共「下载」目录：Android 10+ 走 MediaStore 免权限，只有 6–9 要这个 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
</manifest>
