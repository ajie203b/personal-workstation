<?xml version="1.0" encoding="utf-8"?>
<!-- 任务行悬浮 Bento 小卡（浅色态） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EAF1FE" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#C3D6FA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ECFFFFFF" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#E5ECF6" />
        </shape>
    </item>
</selector>
