<?xml version="1.0" encoding="utf-8"?>
<!-- 任务行悬浮 Bento 小卡（深色曜石蓝玻璃） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#263452" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#3D5584" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D61A2337" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#26334F" />
        </shape>
    </item>
</selector>
