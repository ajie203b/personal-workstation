<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件「+」的原生添加框：只收标题，默认进今日 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_add_bg"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/task_widget_add_title"
        android:textColor="#201F1D"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/task_widget_add_hint"
        android:textColor="#8B887F"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/widget_add_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/widget_add_input_bg"
        android:gravity="top|start"
        android:hint="@string/task_widget_add_placeholder"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="#201F1D"
        android:textColorHint="#A7A39A"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_add_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:text="@string/task_widget_add_cancel"
            android:textColor="#606C7E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_add_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_add_button_bg"
            android:paddingStart="22dp"
            android:paddingTop="10dp"
            android:paddingEnd="22dp"
            android:paddingBottom="10dp"
            android:text="@string/task_widget_add_save"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
