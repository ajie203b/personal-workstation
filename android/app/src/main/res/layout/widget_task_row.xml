<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮 Bento 任务行：优先级语义勾选圆环 + 标题 + 打卡/时间胶囊 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_row_height"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/widget_row_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/widget_check"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:paddingStart="7dp"
            android:paddingTop="10dp"
            android:paddingEnd="7dp"
            android:paddingBottom="10dp"
            android:src="@drawable/widget_check" />

        <TextView
            android:id="@+id/widget_task"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/widget_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_chip_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="6.5dp"
            android:paddingTop="2dp"
            android:paddingEnd="6.5dp"
            android:paddingBottom="2dp"
            android:textColor="@color/widget_chip_text"
            android:textSize="10.5sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
