<?xml version="1.0" encoding="utf-8"?>
<!-- 极简扁平任务行：细圆圈 + 标题 + 轻量右侧文字 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_card"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_row_height"
    android:background="@drawable/widget_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/widget_check"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:paddingStart="2dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:src="@drawable/widget_check" />

    <TextView
        android:id="@+id/widget_task"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/widget_chip_text"
        android:textSize="11.5sp"
        android:visibility="gone" />
</LinearLayout>
