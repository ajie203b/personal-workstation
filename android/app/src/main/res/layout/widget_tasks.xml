<?xml version="1.0" encoding="utf-8"?>
<!-- 极简今日待办小组件 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <!-- 极简单行顶栏：标题 + 轻量计数 + 简洁加号 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/task_widget_name"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/widget_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_add_fab"
            android:contentDescription="快速添加任务"
            android:padding="6dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <!-- 极简扁平任务列表 -->
    <LinearLayout
        android:id="@+id/widget_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 极简空态 -->
    <LinearLayout
        android:id="@+id/widget_empty_wrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/task_widget_all_done"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
