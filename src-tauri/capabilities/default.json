{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口与资源管理器开出的 md-* 文档窗口：基础能力 + 对外 HTTP（WebDAV 同步）+ 应用内更新（检查 / 下载安装 / 重启）",
  "webviews": ["main", "md-*"],
  "permissions": [
    "allow-save-text-file",
    "allow-local-markdown-pick",
    "allow-local-markdown-list",
    "allow-local-markdown-read",
    "allow-local-markdown-write",
    "allow-local-markdown-image",
    "allow-local-document-open-with",
    "allow-local-markdown-defaults",
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "opener:default",
    "updater:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
