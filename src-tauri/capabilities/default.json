{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口与资源管理器开出的 md-* 文档窗口：基础能力 + 对外 HTTP（WebDAV 同步）+ 应用内更新（检查 / 下载安装 / 重启）",
  "windows": ["main", "md-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "opener:default",
    "updater:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}